{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shopstyleretail.com/schemas/welcome-signup-event.schema.json",
  "title": "APIEvent-Welcome-Signup",
  "description": "Payload schema for POST /interaction/v1/events, EventDefinitionKey=APIEvent-Welcome-Signup. See api/rest/event-signup.md.",
  "type": "object",
  "required": ["ContactKey", "EventDefinitionKey", "Data"],
  "properties": {
    "ContactKey": { "type": "string", "minLength": 1 },
    "EventDefinitionKey": { "const": "APIEvent-Welcome-Signup" },
    "Data": {
      "type": "object",
      "required": ["SubscriberKey", "EmailAddress", "SignupDate"],
      "properties": {
        "SubscriberKey": { "type": "string", "minLength": 1 },
        "EmailAddress": { "type": "string", "format": "email" },
        "FirstName": { "type": "string" },
        "SignupSource": { "type": "string", "enum": ["Web", "MobileApp", "InStoreKiosk", "SocialLogin", "SmartCapture"] },
        "SignupDate": { "type": "string", "format": "date-time" },
        "PromoCodeIssued": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
