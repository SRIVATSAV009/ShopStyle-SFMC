{
  "name": "Shared_ProductCatalog",
  "customerKey": "DE_SHARED_PRODUCTCATALOG",
  "description": "Parent-BU shared master product feed, synced nightly from the commerce platform via automation-studio/sql & file transfer. Read-only to Child BUs.",
  "isSendable": false,
  "sharedTo": ["5000011", "5000012", "5000013"],
  "retentionPolicy": { "type": "None", "notes": "Always current snapshot; overwritten nightly, no historical retention" },
  "fields": [
    { "name": "SKU", "type": "Text", "length": 40, "isPrimaryKey": true, "isRequired": true },
    { "name": "ProductName", "type": "Text", "length": 200 },
    { "name": "Category", "type": "Text", "length": 60 },
    { "name": "SubCategory", "type": "Text", "length": 60 },
    { "name": "Brand", "type": "Text", "length": 100 },
    { "name": "Price", "type": "Decimal", "scale": 2 },
    { "name": "SalePrice", "type": "Decimal", "scale": 2 },
    { "name": "InStock", "type": "Boolean", "defaultValue": "true" },
    { "name": "InventoryCount", "type": "Number" },
    { "name": "ImageURL", "type": "Text", "length": 500 },
    { "name": "ProductURL", "type": "Text", "length": 500 },
    { "name": "AvgRating", "type": "Decimal", "scale": 1 },
    { "name": "LastSyncedDate", "type": "Date" }
  ]
}
